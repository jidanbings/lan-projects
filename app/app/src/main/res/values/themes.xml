<resources>
    <style name="Theme.LanProjects" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#3367d6</item>
        <item name="colorPrimaryDark">#2854b0</item>
        <!-- Dark everywhere so the top status strip merges with the app's own
             dark top bar, even on Android 15 (targetSdk 35) where edge-to-edge
             makes both system bars transparent. -->
        <item name="android:windowBackground">#263238</item>
        <item name="android:statusBarColor">#263238</item>
        <item name="android:navigationBarColor">#263238</item>
    </style>

    <!-- Scanner theme: dark, black system bars. Hide zxing's default viewfinder
         (mask + laser) - the WeChat-style frame is drawn by the custom
         WeChatViewfinderView overlay instead. -->
    <style name="ScanTheme" parent="zxing_CaptureTheme">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="zxing_viewfinder_laser_visibility">false</item>
        <item name="zxing_viewfinder_mask">#00000000</item>
    </style>
</resources>
