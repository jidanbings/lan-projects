<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen (App 首页): dark theme, unified with MainActivity's top bar
     and the app theme (#263238 family). Structure kept identical so all view
     IDs used by LaunchActivity still resolve; only the visuals changed. -->
<io.lanprojects.phone.PullRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_launch_gradient">

    <!-- Pull-to-refresh spinner: appears above the page while pulling down.
         Drawn before the ScrollView so it sits behind it and is revealed as the
         content is pulled away from the top. -->
    <ProgressBar
        android:id="@+id/refreshIndicator"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:indeterminateTint="#82B1FF"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Hero: title / tagline / version badge (no app icon - the user
                 does not want the launcher icon repeated on the opening screen) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="lan-projects"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="局域网文件共享 · 端对端加密"
                android:textColor="#90A4AE"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge"
                android:paddingLeft="12dp"
                android:paddingTop="3dp"
                android:paddingRight="12dp"
                android:paddingBottom="3dp"
                android:textColor="#B0BEC5"
                android:textSize="11sp" />

            <!-- Status card: connection dot + LAN address + copy -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_status_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_offline" />

                    <TextView
                        android:id="@+id/connectionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="未连接网络"
                        android:textColor="#B0BEC5"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lanIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="获取中…"
                    android:textColor="#FFFFFF"
                    android:textIsSelectable="true"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="复制地址发给朋友，或粘贴到浏览器打开"
                        android:textColor="#90A4AE"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnCopyIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_btn_outline"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:text="复制地址"
                        android:textColor="#B0BEC5"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Primary action: host mode -->
            <Button
                android:id="@+id/btnHost"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="📱 用本设备作为启动\n本机当服务器，其他设备扫码加入"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Secondary action: scan a connect QR -->
            <Button
                android:id="@+id/btnScan"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_secondary"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="📷 扫码连接\n扫对方二维码：连接 / 配对 / 加入房间"
                android:textColor="#ECEFF1"
                android:textSize="14sp" />

            <!-- Recent connections -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="最近连接"
                    android:textColor="#90A4AE"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/recentClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="清空"
                    android:textColor="#82B1FF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/recentHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="暂无连接记录"
                android:textColor="#78909C"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/recentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- Bottom breathing room -->
            <View
                android:layout_width="match_parent"
                android:layout_height="28dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Settings, floating top-right over the dark gradient. -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_settings_btn"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingRight="14dp"
        android:paddingBottom="8dp"
        android:text="⚙ 设置"
        android:textColor="#ECEFF1"
        android:textSize="12sp" />
</io.lanprojects.phone.PullRefreshLayout>
