<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scanRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- The camera (id is required by CaptureActivity). zxing's own viewfinder
         is hidden via ScanTheme; the WeChat-style frame is drawn by the overlay
         below. -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- WeChat-style mask + green corners + green scan line. -->
    <io.lanprojects.phone.WeChatViewfinderView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar with a back button (WeChat-style). -->
    <LinearLayout
        android:id="@+id/scanTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/btnScanBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="← 返回"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Bottom hint (WeChat-style). -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="将二维码放入框内，即可自动扫描"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />
</FrameLayout>
