<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen background: subtle light gray gradient (same family as the
     #ECEFF1 theme) so the hero area is slightly lighter near the top while the
     whole page stays in the same light theme as the settings page. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F8FAFB"
        android:endColor="#ECEFF1" />
</shape>
