{
  "name": "lan-projects",
  "version": "1.0.0",
  "type": "module",
  "description": "在浏览器中实现局域网文件共享。跨平台的 AirDrop 替代方案。",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js --include-ws-fallback",
    "start:prod": "node server/index.js --include-ws-fallback --rate-limit --auto-restart",
    "start:dev": "node server/index.js --include-ws-fallback --auto-restart"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "ua-parser-js": "^1.0.37",
    "unique-names-generator": "^4.3.0",
    "ws": "^8.16.0"
  }
}
